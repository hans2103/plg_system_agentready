{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/bin/claude-pr-guard.sh\" ] || exit 0; bash \"$CLAUDE_PROJECT_DIR/bin/claude-pr-guard.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
